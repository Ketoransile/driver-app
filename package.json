{
  "name": "merkato-driver",
  "version": "1.0.0",
  "description": "Last-Mile Delivery Driver App for Ethiopia",
  "scripts": {
    "dev": "concurrently \"npm run backend\" \"npm run frontend\"",
    "backend": "cd backend && npm run dev",
    "frontend": "cd driver-app && npm start",
    "install:all": "npm install && cd backend && npm install && cd ../driver-app && npm install"
  },
  "keywords": [
    "delivery",
    "logistics",
    "ethiopia",
    "react-native",
    "expo"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
